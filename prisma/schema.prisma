// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A buyer is the customer who purchased Shagan POS. Each POS organization
// lives in the Go backend; BuyerService just links this buyer to that
// external record.
model Buyer {
  id             String         @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  billingAddress String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  services       BuyerService[]
}

model BuyerService {
  id     String @id @default(cuid())
  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // Always "organization" today - kept as a plain string so another kind
  // of service can be added later without a migration.
  serviceType String

  // The organization's ID in the Go backend.
  externalId String

  // Display name captured at purchase time (the organization's name).
  label String

  // Informational only - the Go backend is the source of truth for org status.
  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceType, externalId])
  @@index([buyerId])
}
