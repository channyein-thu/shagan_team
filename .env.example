# Shagan POS backend (Go/Gin service). The browser never talks to this
# directly - only this Next.js app's server-side code does.
BACKEND_API_URL="
INTERNAL_API_KEY="replace-with-the-shared-internal-api-key"

# NextAuth.js (Auth.js) - secret used to sign session tokens.
# Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Local admin user store (SQLite via Prisma) for portal login.
DATABASE_URL=""

# Used only by `npm run db:seed` to create/update the first admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD="replace-with-a-secure-password"
SEED_ADMIN_NAME=""
